name_en = "Echo Mark"
name_ar = "علامة الصدى"
description_en = "Creatures hit by your pulse keep a faint outline for 4 s. The outline alone does not make them hittable."
description_ar = "المخلوقات التي تصيبها نبضتكِ يبقى حولها خط خافت لمدة 4 ث. الخط وحده لا يجعل ضربها ممكناً."
tip_en = "The Guardian can follow marked creatures in the dark and wait for the right moment."
tip_ar = "يستطيع الحارس تتبّع المخلوقات المعلَّمة في الظلام وانتظار اللحظة المناسبة."
